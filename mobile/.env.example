# Mobile app environment variables. Copy to .env.local and fill in.
# Anything prefixed with EXPO_PUBLIC_ is bundled into the JS — do NOT put service-role keys here.

# Supabase project URL — e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon key — safe to ship in client (RLS enforces access).
#
# Must be the self-hosted box's LEGACY JWT anon key (starts `eyJ…`), found in
# /root/supabase/.env as ANON_KEY. A new-style `sb_publishable_…` key will NOT
# work: Realtime validates this value as a JWT and rejects it with
# `403 MalformedJWT`, killing every websocket while REST keeps working — so the
# failure is silent and looks like "live updates just don't happen".
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry DSN — leave empty in dev. Events are silenced until Phase 10.
EXPO_PUBLIC_SENTRY_DSN=

# Environment marker — "development" or "production"
EXPO_PUBLIC_ENV=development
